<?xml version="1.0" encoding="utf-8"?>
<!--
  The favorites file is encrypted with a key that lives in the AndroidKeyStore and
  never leaves the device, so a backup copy would be undecryptable anyway. We exclude
  it explicitly so the intent is documented rather than implied.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
